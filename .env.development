# 开发环境（vite dev / vite build --mode development）
# 只在本机 Node 侧使用，没有 VITE_ 前缀，因此不会被打进前端产物
# 值不要带结尾斜杠，changeOrigin 时 Host 会被改写为该地址
# 本机 9080 被 NahimicService 占用，开发端口统一改为 9081（与后端 application-dev.yaml 一致）
API_PROXY_TARGET=http://localhost:9081

# 是否使用内置模拟数据（后端未就绪时设为 true）
# true  = 请求被 mock 适配器拦截，数据存 localStorage
# false = 请求真实发往 API_PROXY_TARGET 指向的 Spring Boot 服务
VITE_USE_MOCK=false
